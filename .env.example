# OpenSquid environment config
# Copy to .env and adjust for your platform

# Root of opensquid repo
OPENSQUID_ROOT="$HOME/claude/opensquid"

# Python interpreter (with required deps installed)
# Linux (miniconda): $HOME/miniconda3/envs/agent/bin/python3
# Mac (homebrew):    /opt/homebrew/bin/python3
# Mac (miniconda):   $HOME/miniconda3/bin/python3
OPENSQUID_PYTHON="$HOME/miniconda3/envs/agent/bin/python3"

# Python for AgentCortexManager (needs sentence-transformers)
# Usually same as above, but may differ
OPENSQUID_CORTEX_PYTHON="$HOME/miniconda3/bin/python3"

# Claude CLI path
# Linux: $HOME/.npm-global/bin/claude
# Mac:   $HOME/.npm-global/bin/claude  (same if installed via npm)
OPENSQUID_CLAUDE_CLI="$HOME/.npm-global/bin/claude"

# Node binary directories (for claude CLI)
# Linux: /usr/local/bin:/usr/bin
# Mac:   /usr/local/bin:/opt/homebrew/bin
OPENSQUID_NODE_PATHS="/usr/local/bin:/usr/bin"

# Auth token (shared across all services)
DAEMON_AUTH_TOKEN="emc2ymmv"
ANTHROPIC_API_KEY=""

# Upstream MCP endpoints (remote — same on any platform)
CORTEX_URL="https://autonomous.fahrenheitrequited.dev"
OPENMIND_URL="https://openmind.fahrenheitrequited.dev"
RWX_URL="https://rwx.fahrenheitrequited.dev"

# Telegram (for channels-server)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_IDS=""

# Voice wake (for voice-wake.py)
PORCUPINE_ACCESS_KEY=""
WAKE_WORD="jarvis"
