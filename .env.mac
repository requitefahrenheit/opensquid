# Mac configuration for OpenSquid
# Copy to .env on your Mac and adjust paths

OPENSQUID_ROOT="$HOME/claude/opensquid"

# Mac Python options (uncomment whichever applies):
# Homebrew:
OPENSQUID_PYTHON="/opt/homebrew/bin/python3"
OPENSQUID_CORTEX_PYTHON="/opt/homebrew/bin/python3"
# Miniconda (if installed):
# OPENSQUID_PYTHON="$HOME/miniconda3/bin/python3"
# OPENSQUID_CORTEX_PYTHON="$HOME/miniconda3/bin/python3"

# Claude CLI (same location if installed via npm)
OPENSQUID_CLAUDE_CLI="$HOME/.npm-global/bin/claude"

# Node paths on Mac
OPENSQUID_NODE_PATHS="/usr/local/bin:/opt/homebrew/bin"

# Auth
DAEMON_AUTH_TOKEN="emc2ymmv"
ANTHROPIC_API_KEY=""

# Remote MCP endpoints (Cloudflare tunnel — same from any machine)
CORTEX_URL="https://autonomous.fahrenheitrequited.dev"
OPENMIND_URL="https://openmind.fahrenheitrequited.dev"
RWX_URL="https://rwx.fahrenheitrequited.dev"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_IDS=""

# Voice wake
PORCUPINE_ACCESS_KEY=""
WAKE_WORD="jarvis"
